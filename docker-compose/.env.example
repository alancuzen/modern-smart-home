# Repo:   docker-compose/.env.example
# Copy to docker-compose/.env on the Docker VM and chmod 600 it.
# Every stack reads it with: docker compose --env-file ../.env up -d
HOST_IP=10.0.10.55
PUID=1000
PGID=1000
TZ=Europe/London
POSTGRES_PASSWORD=CHANGE_ME
# Image tags. Frigate 0.17.2 includes security fixes; 0.18 changed the
# config format and is not covered by this edition. Pin OLLAMA and PIPER
# to the versions you test (docker image inspect shows the digest).
FRIGATE_TAG=0.17.2-tensorrt
OLLAMA_TAG=latest
WHISPER_TAG=gpu
PIPER_TAG=latest
