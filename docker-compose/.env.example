# Repo:   docker-compose/.env.example
# Copy to docker-compose/.env on the Docker VM and chmod 600 it.
# Every stack reads it with: docker compose --env-file ../.env up -d
HOST_IP=10.0.10.55
PUID=1000
PGID=1000
TZ=Europe/London
POSTGRES_PASSWORD=CHANGE_ME
# Image tags: exact versions, so every reader runs the same software.
# Frigate 0.18.0 is the first release that supports NVIDIA RTX 50-series
# (Blackwell) GPUs. WHISPER_TAG is the NVIDIA build ("gpu-", not
# "gpu-legacy-", which is for older cards).
FRIGATE_TAG=0.18.0-tensorrt
OLLAMA_TAG=0.34.4
WHISPER_TAG=gpu-v3.8.1-ls67
PIPER_TAG=2.5.2
