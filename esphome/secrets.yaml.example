# Repo:   esphome/secrets.yaml.example
# Deploy: /config/esphome/secrets.yaml (never commit the real file)
# Generate each API key with:  openssl rand -base64 32
# Each key also encrypts that node's OTA updates (ESPHome 2026.9+).
wifi_ssid: "Home-IoT"
wifi_password: "CHANGE_ME"
fallback_ap_password: "CHANGE_ME"
api_key_ble_proxy: "REPLACE_WITH_BASE64_KEY"
api_key_environmental: "REPLACE_WITH_BASE64_KEY"
api_key_intercom: "REPLACE_WITH_BASE64_KEY"
api_key_radar: "REPLACE_WITH_BASE64_KEY"
api_key_smart_plug: "REPLACE_WITH_BASE64_KEY"
api_key_voice_satellite: "REPLACE_WITH_BASE64_KEY"
api_key_heating: "REPLACE_WITH_BASE64_KEY"
