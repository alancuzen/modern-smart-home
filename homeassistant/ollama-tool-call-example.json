{
  "model": "llama3.1:8b",
  "stream": false,
  "messages": [
    { "role": "system",
      "content": "You are a local smart home assistant. Use the tools." },
    { "role": "user",
      "content": "It feels a bit dark in the living room." }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "llm_set_light_state",
        "description": "Turn a light on or off and optionally set brightness.",
        "parameters": {
          "type": "object",
          "properties": {
            "light_entity": { "type": "string",
                           "description": "e.g. light.living_room_overhead" },
            "power": { "type": "string", "enum": ["on", "off"] },
            "brightness_pct": { "type": "integer",
                                "minimum": 1, "maximum": 100 }
          },
          "required": ["light_entity", "power"]
        }
      }
    }
  ]
}
